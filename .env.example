# Copy to .env (never commit it) or set these in your host's secret settings.

# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Dashboard
DASHBOARD_PASSWORD=
PORT=8787
# Public address of the dashboard, used for links in notifications
PUBLIC_URL=
# Where notifications go: a Slack incoming webhook
SLACK_WEBHOOK_URL=
SCHEDULE_TZ=America/New_York
# Turn the built-in scheduler off (e.g. when running jobs from an external cron): SCHEDULER=off
# Override any job's schedule, or turn it off: SCHEDULE_DRAFTS="0 7 * * 1-5", SCHEDULE_MENTIONS=off
DB_PATH=data/social-agent.db

# --- Platforms. Leave a block empty to skip that platform. ---
# A person's own account uses the same name with their entity id appended,
# e.g. LINKEDIN_ACCESS_TOKEN_RICHARD_BOYD and LINKEDIN_AUTHOR_RICHARD_BOYD=urn:li:person:...

# X: OAuth 2.0 user token with tweet.read tweet.write users.read; X_USER_ID enables mention checks
X_ACCESS_TOKEN=
X_USER_ID=

# LinkedIn (see docs/SETUP.md, step 5)
# Company pages (Community Management API): one page admin's token covers both pages; each page needs its id.
# Optional refresh credentials let the token renew itself.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR=
LINKEDIN_AUTHOR_QUESTSIM=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=
# Personal profiles, optional (Share on LinkedIn): each person's 60-day token; their author id is looked up automatically
LINKEDIN_ACCESS_TOKEN_RICHARD_BOYD=
LINKEDIN_ACCESS_TOKEN_LINDA_BERNARD=
LINKEDIN_ACCESS_TOKEN_BOB_KLEINHAMPLE=
LINKEDIN_VERSION=202609

# Facebook Pages (see docs/SETUP.md) and an Instagram professional account linked to the UltiSim Page
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN_QUESTSIM=
META_PAGE_ID_QUESTSIM=
INSTAGRAM_USER_ID=
META_GRAPH_VERSION=v23.0

# Reddit "script" app for the account that posts
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=ultisim-social-agent/0.1 by u/your_username

# Discord channel webhook
DISCORD_WEBHOOK_URL=
